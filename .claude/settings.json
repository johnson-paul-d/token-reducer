{
  "extraKnownMarketplaces": {
    "Madhan230205-claude-token-reducer": {
      "source": {
        "source": "github",
        "repo": "Madhan230205/token-reducer"
      }
    }
  },
  "enabledPlugins": {
    "claude-token-reducer@Madhan230205-claude-token-reducer": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/setup-token-reducer.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
